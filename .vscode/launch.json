{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",    
    "configurations": [        
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",  //attch will use pid, do not use it. 
            "program": "${workspaceFolder}/vmlinux", 
            "args": [],
            "stopAtEntry": true,   
            "cwd": "${workspaceRoot}",
            "environment": [],
            "externalConsole": false,       ///  false/Mandatory for gdb debugging!!!

            "logging": {/////  added manually for log
                "moduleLoad": true,
                //"trace": true,
                "engineLogging": true,
                "programOutput": true,
                "exceptions": true,
                //"traceResponse": true
            },
            "MIMode": "gdb", 
            "setupCommands": [                
                {
                    "text": "dir .",
                    "ignoreFailures": false
                  },
                  {
                    "text": "add-auto-load-safe-path ./",
                    "ignoreFailures": false
                  },
                  {
                    "description": "Set sysroot ",
                    "text": "set sysroot ./"
               },
               {
                    "description": "Set solib",
                    "text": "set solib-search-path ./"
               },
                  {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true,
                    //"set follow-fork-mode":"child"
                }        
            ],
            ///////////"preLaunchTask": "Build and run",   ///start gdbserver in backgroud 
            "preLaunchTask": "run",
            /// Try Ubuntu20 with gdb9/gdb-multiarch 
            "miDebuggerPath": "gdb-multiarch",
            "targetArchitecture": "arm",
            "miDebuggerServerAddress": "localhost:41234",
            ////"sourceFileMap": {"./":"${workspaceFolder}"}
            }
    ]
}
