diff -Naur linux-0.01-rm-3.3/Makefile linux-0.01-rm-3.4/Makefile
--- linux-0.01-rm-3.3/Makefile	2007-12-26 13:01:59.000000000 +0100
+++ linux-0.01-rm-3.4/Makefile	2008-01-13 22:07:59.000000000 +0100
@@ -61,8 +61,8 @@
 	(cd lib; make)
 
 boot/boot:	boot/boot.s tools/system
-	(echo -n "SYSSIZE = (";ls -l tools/system | grep system \
-		| cut -c31-37 | tr '\012' ' '; echo "+ 15 ) / 16") > tmp.s
